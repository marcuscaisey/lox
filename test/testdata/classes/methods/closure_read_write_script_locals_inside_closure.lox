var a = "global a";
var b = "global b";

var outer;
var printAB;

{
  var a = "local a";
  var b = "local b";

  class Outer {
    outer() {
      class Inner {
        inner(location) {
          a = location + " a";
          b = location + " b";
        }

        printAB() {
          print a;
          print b;
        }
      }

      var inner = Inner();
      printAB = inner.printAB;
      inner.inner("inside outer");
      // prints: inside outer a
      // prints: inside outer b
      printAB();
      return inner;
    }
  }

  outer = Outer().outer;
}

var inner = outer();
inner.inner("outside outer");
// prints: outside outer a
// prints: outside outer b
printAB();
print a; // prints: global a
print b; // prints: global b
