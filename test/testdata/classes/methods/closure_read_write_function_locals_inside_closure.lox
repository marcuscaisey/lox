var a = "global a";
var b = "global b";

fun printAB() {
  print a;
  print b;
}

fun outer() {
  var a = "outer a";

  class Middle {
    middle() {
      var b = "middle b";

      class Inner {
        inner(location) {
          a = location + " a";
          b = location + " b";
        }

        printAB() {
          print a;
          print b;
        }
      }

      var inner = Inner();
      printAB = inner.printAB;
      inner.inner("inside middle");
      // prints: inside middle a
      // prints: inside middle b
      printAB();
      return inner;
    }
  }

  return Middle().middle();
}

var inner = outer();
inner.inner("outside outer");
// prints: outside outer a
// prints: outside outer b
printAB();
print a; // prints: global a
print b; // prints: global b
