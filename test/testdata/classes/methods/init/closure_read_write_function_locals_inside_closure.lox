var a = "global a";
var b = "global b";

var Inner;
var printAB;

fun outer() {
  var a = "outer a";

  class Middle {
    init() {
      var b = "middle b";

      class InnerLocal {
        init(location) {
          a = location + " a";
          b = location + " b";
        }
      }

      class PrintAB {
        init() {
          print a;
          print b;
        }
      }

      InnerLocal("inside middle");
      printAB = PrintAB;
      // prints: inside middle a
      // prints: inside middle b
      printAB();
      Inner = InnerLocal;
    }
  }

  Middle();
}

outer();
Inner("outside outer");
// prints: outside outer a
// prints: outside outer b
printAB();
print a; // prints: global a
print b; // prints: global b
