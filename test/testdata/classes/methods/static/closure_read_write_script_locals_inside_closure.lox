var a = "global a";
var b = "global b";

var outer;
var printAB;

{
  var a = "local a";
  var b = "local b";

  class OuterLocal {
    static outer() {
      class Inner {
        static inner(location) {
          a = location + " a";
          b = location + " b";
        }

        static printAB() {
          print a;
          print b;
        }
      }

      printAB = Inner.printAB;
      Inner.inner("inside outer");
      // prints: inside outer a
      // prints: inside outer b
      printAB();
      return Inner;
    }
  }

  outer = OuterLocal.outer;
}

var inner = outer();
inner.inner("outside outer");
// prints: outside outer a
// prints: outside outer b
printAB();
print a; // prints: global a
print b; // prints: global b
