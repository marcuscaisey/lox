for (var i = 0;; i = i + 1) {
  if (i >= 3) {
    break;
  }
  // prints: 0
  // prints: 1
  // prints: 2
  print i;
}

for (var j = 0; j < 3; j = j + 1) {
  for (var k = 0;; k = k + 1) {
    if (k == 1) {
      break;
    }
    // prints: 0
    // prints: 1
    // prints: 2
    print j;
  }
}

for (var l = 0;; l = l + 1) {
  if (l > 5) {
    break;
  }
  // prints: 0
  // prints: 1
  // prints: 2
  print l;
  if (l >= 2) {
    break;
  }
}
